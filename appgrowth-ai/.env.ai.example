# ── AppGrowth AI service (Python). Only the API can call it (same AI_SERVICE_TOKEN). ──
AI_SERVICE_TOKEN=
AI_DEFAULT_PROVIDER=gemini             # gemini | anthropic | openai | ollama (the Super Admin can override per agent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=                          # set explicitly if OpenAI is used for text
OLLAMA_BASE_URL=                       # e.g. http://ollama:11434 for self-hosted inference
OLLAMA_MODEL=llama3.1:8b
REQUEST_TIMEOUT_SEC=180
