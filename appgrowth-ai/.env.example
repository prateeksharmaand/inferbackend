# ── AppGrowth AI — API / worker / scheduler environment ──────────────────────────────────────────
# Copy to .env on the server (chmod 600). Never commit real values. Generate secrets with: openssl rand -hex 32

NODE_ENV=production
APP_VERSION=latest                     # set by scripts/deploy.sh (git sha)
PORT=4100
PUBLIC_URL=https://marketing.noushealthcare.online   # used in emails and OAuth redirect URIs
WEB_ORIGIN=https://marketing.noushealthcare.online   # allowed CORS origin(s), comma-separated

# PostgreSQL (role "appgrowth" owning database "appgrowth"; RLS role "appgrowth_tenant" is granted to it)
DATABASE_URL=postgresql://appgrowth:CHANGE_ME@appgrowth-postgres:5432/appgrowth?schema=public&connection_limit=8
POSTGRES_PASSWORD=CHANGE_ME           # only for the "db" compose profile

# Redis (queues, locks, cache). Password must match REDIS_PASSWORD.
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@appgrowth-redis:6379/0

# Secrets — 32+ random bytes each. Rotating DATA_ENCRYPTION_KEY requires re-encryption (docs/SECURITY.md).
JWT_ACCESS_SECRET=                     # openssl rand -hex 32
DATA_ENCRYPTION_KEY=                   # openssl rand -hex 32  (exactly 64 hex chars; AES-256-GCM for tokens/keys)
DEVICE_HASH_SALT=                      # openssl rand -hex 16  (salts device-id hashes; never change after go-live)
METRICS_TOKEN=                         # openssl rand -hex 24  (Prometheus bearer token; also in secrets/metrics_token)
RATE_LIMIT_PER_MIN=300
ADMIN_MFA_REQUIRED=true                # false lets Super Admin/Support use the console without two-factor (not recommended)

# Internal AI service
AI_SERVICE_URL=http://appgrowth-ai:8100
AI_SERVICE_TOKEN=                      # openssl rand -hex 24 — same value in .env.ai

# File storage: local (default, volume /data/storage) or minio
STORAGE_DRIVER=local
STORAGE_PATH=/data/storage
# MINIO_ENDPOINT=appgrowth-minio
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=appgrowth
# CLAMAV_HOST=appgrowth-clamav         # enable upload malware scanning (compose profile "clamav", ~1.2 GB RAM)

# Email (SMTP). Without SMTP_HOST emails are logged as not sent (never reported as delivered).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AppGrowth AI <no-reply@noushealthcare.online>

# Billing
BILLING_TAX_RATE_PCT=18                # GST on subscription invoices

# First Super Admin (used only by the seed; remove after first deploy)
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Platform Admin

# ── Advertising platforms (leave empty until API access is approved; also enable integration.* feature flags) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=          # optional manager account id
GOOGLE_ADS_API_VERSION=v22
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Apple Ads needs no platform credentials: each customer connects with their own API client.

# Monitoring
GRAFANA_ADMIN_PASSWORD=
