{
  "name": "@appgrowth/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc prisma/seed.ts --outDir dist-seed --module commonjs --target es2022 --esModuleInterop --skipLibCheck",
    "start": "node dist/main",
    "start:worker": "node dist/worker",
    "start:scheduler": "node dist/scheduler",
    "dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:prod": "node dist-seed/prisma/seed.js"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "minio": "^8.0.7",
    "nodemailer": "^10.6.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "msgpackr-extract@3.0.7": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@scarf/scarf": false,
    "fsevents": false
  },
  "engines": {
    "node": ">=22.12"
  }
}
