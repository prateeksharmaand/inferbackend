// AppGrowth AI — PostgreSQL schema.
// Conventions: UUID keys; timestamps are timestamptz (UTC); money is BigInt minor units (paise/cents) + ISO currency;
// every tenant-owned table has organizationId and is protected by Row Level Security (see migrations/*_rls).
// Provider-side identifiers live in `external*` columns, never in our primary keys.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  NONE
}

enum Platform {
  ANDROID
  IOS
}

enum AdProvider {
  GOOGLE_ADS
  APPLE_ADS
  META_ADS
  TIKTOK_ADS
}

enum AnalyticsProviderKind {
  FIREBASE
  GA4
  APPSFLYER
  ADJUST
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
  DISCONNECTED
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  READY
  ACTIVE
  PAUSED
  FAILED
  COMPLETED
  ARCHIVED
}

enum AutonomyLevel {
  RECOMMENDATION
  APPROVED_AUTOMATION
  AUTONOMOUS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CreativeType {
  AD_COPY
  HEADLINE
  DESCRIPTION
  IMAGE
  VIDEO
  VIDEO_SCRIPT
  SOCIAL_POST
  BANNER
  SCREENSHOT_CONCEPT
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  AWAITING_REVIEW
}

enum InstallKind {
  FIRST_INSTALL
  REINSTALL
}

enum AttributionType {
  ORGANIC
  PAID
  UNATTRIBUTED
}

enum AttributionGranularity {
  USER_LEVEL
  AGGREGATE // SKAdNetwork / AdAttributionKit / modelled reporting
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

// ───────────────────────── SaaS & authentication ─────────────────────────

model Organization {
  id                String        @id @default(uuid()) @db.Uuid
  name              String
  slug              String        @unique
  status            OrgStatus     @default(ACTIVE)
  suspendedReason   String?
  country           String        @default("IN")
  currency          String        @default("INR") @db.Char(3)
  timezone          String        @default("Asia/Kolkata")
  brandColors       Json          @default("[]")
  brandVoice        String        @default("")
  brandGuidelines   String        @default("")
  logoAssetKey      String?
  autonomyLevel     AutonomyLevel @default(RECOMMENDATION)
  automationEnabled Boolean       @default(true)
  emergencyStopAt   DateTime?     @db.Timestamptz
  createdAt         DateTime      @default(now()) @db.Timestamptz
  updatedAt         DateTime      @updatedAt @db.Timestamptz
  deletedAt         DateTime?     @db.Timestamptz

  members       OrganizationMember[]
  invitations   Invitation[]
  subscriptions Subscription[]
  applications  Application[]
  accounts      ConnectedAccount[]
  campaigns     Campaign[]
  budgets       OrganizationBudget[]
  policy        AutomationPolicy?

  @@map("organizations")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  name            String
  passwordHash    String?
  status          UserStatus   @default(ACTIVE)
  platformRole    PlatformRole @default(NONE)
  emailVerifiedAt DateTime?    @db.Timestamptz
  mfaSecretEnc    String? // AES-GCM encrypted TOTP secret
  mfaEnabledAt    DateTime?    @db.Timestamptz
  failedLogins    Int          @default(0)
  lockedUntil     DateTime?    @db.Timestamptz
  lastLoginAt     DateTime?    @db.Timestamptz
  createdAt       DateTime     @default(now()) @db.Timestamptz
  updatedAt       DateTime     @updatedAt @db.Timestamptz
  deletedAt       DateTime?    @db.Timestamptz

  memberships OrganizationMember[]
  sessions    UserSession[]
  resetTokens PasswordResetToken[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // owner, admin, marketer, analyst, viewer
  name        String
  description String   @default("")
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz

  permissions RolePermission[]
  members     OrganizationMember[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique // e.g. apps.write
  description String @default("")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  roleId         String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model UserSession {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  organizationId String?        @db.Uuid // active org for this session
  ip             String?
  userAgent      String?
  mfaVerified    Boolean        @default(false)
  createdAt      DateTime       @default(now()) @db.Timestamptz
  lastSeenAt     DateTime       @default(now()) @db.Timestamptz
  revokedAt      DateTime?      @db.Timestamptz
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]

  @@index([userId])
  @@map("user_sessions")
}

/// Rotating refresh tokens. Each use creates a successor; presenting a used token revokes the whole family.
model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  tokenHash String      @unique
  expiresAt DateTime    @db.Timestamptz
  usedAt    DateTime?   @db.Timestamptz
  createdAt DateTime    @default(now()) @db.Timestamptz
  session   UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  email          String
  roleKey        String
  tokenHash      String       @unique
  invitedById    String?      @db.Uuid
  expiresAt      DateTime     @db.Timestamptz
  acceptedAt     DateTime?    @db.Timestamptz
  createdAt      DateTime     @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitations")
}

model SubscriptionPlan {
  id                 String   @id @default(uuid()) @db.Uuid
  key                String   @unique // free_trial, starter, professional, agency, enterprise
  name               String
  description        String   @default("")
  priceMinor         BigInt   @default(0)
  currency           String   @default("INR") @db.Char(3)
  interval           String   @default("month") // month | year
  trialDays          Int      @default(0)
  maxApps            Int
  maxMembers         Int
  maxAdAccounts      Int
  aiGenerationsMonth Int
  aiTokensMonth      BigInt
  features           Json     @default("{}")
  isPublic           Boolean  @default(true)
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @db.Timestamptz
  currentPeriodEnd   DateTime           @db.Timestamptz
  trialEndsAt        DateTime?          @db.Timestamptz
  cancelAtPeriodEnd  Boolean            @default(false)
  externalId         String? // payment gateway subscription id
  createdAt          DateTime           @default(now()) @db.Timestamptz
  updatedAt          DateTime           @updatedAt @db.Timestamptz
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  invoices           Invoice[]

  @@index([organizationId, status])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  subscriptionId String?       @db.Uuid
  number         String        @unique
  status         String        @default("open") // draft | open | paid | void
  subtotalMinor  BigInt
  taxMinor       BigInt        @default(0)
  totalMinor     BigInt
  currency       String        @db.Char(3)
  periodStart    DateTime      @db.Timestamptz
  periodEnd      DateTime      @db.Timestamptz
  lines          Json          @default("[]")
  issuedAt       DateTime      @default(now()) @db.Timestamptz
  paidAt         DateTime?     @db.Timestamptz
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  payments       Payment[]

  @@index([organizationId, issuedAt])
  @@map("invoices")
}

model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  invoiceId      String?  @db.Uuid
  amountMinor    BigInt
  currency       String   @db.Char(3)
  method         String // gateway | bank_transfer | manual
  status         String   @default("succeeded")
  externalId     String?
  receivedAt     DateTime @default(now()) @db.Timestamptz
  recordedById   String?  @db.Uuid
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])

  @@unique([method, externalId])
  @@index([organizationId])
  @@map("payments")
}

// ───────────────────────── Application management ─────────────────────────

model Application {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @db.Uuid
  name                 String
  category             String       @default("")
  description          String       @default("")
  targetAudience       String       @default("")
  iconAssetKey         String?
  monthlyInstallTarget Int          @default(10000)
  targetCpiMinor       BigInt?
  currency             String       @default("INR") @db.Char(3)
  status               String       @default("active") // active | paused | archived
  onboardingStatus     String       @default("pending") // pending | running | done | failed
  createdAt            DateTime     @default(now()) @db.Timestamptz
  updatedAt            DateTime     @updatedAt @db.Timestamptz
  deletedAt            DateTime?    @db.Timestamptz
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  platforms ApplicationPlatform[]
  listings  ApplicationStoreListing[]
  assets    ApplicationAsset[]
  countries ApplicationCountry[]
  languages ApplicationLanguage[]
  targets   ApplicationTarget[]
  campaigns Campaign[]

  @@index([organizationId, deletedAt])
  @@map("applications")
}

model ApplicationPlatform {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  applicationId  String      @db.Uuid
  platform       Platform
  storeId        String // Android package name or iOS bundle id
  storeUrl       String      @default("")
  appleAppId     String? // numeric App Store id (iOS)
  validatedAt    DateTime?   @db.Timestamptz
  validationNote String      @default("")
  createdAt      DateTime    @default(now()) @db.Timestamptz
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, platform])
  @@unique([organizationId, platform, storeId])
  @@map("application_platforms")
}

/// Store metadata snapshots: one row per fetch, so listing changes can be diffed.
model ApplicationStoreListing {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  applicationId  String      @db.Uuid
  platform       Platform
  country        String      @default("IN")
  language       String      @default("en")
  title          String      @default("")
  subtitle       String      @default("")
  description    String      @default("")
  developer      String      @default("")
  rating         Decimal?    @db.Decimal(3, 2)
  ratingCount    Int?
  iconUrl        String      @default("")
  screenshotUrls Json        @default("[]")
  raw            Json        @default("{}")
  source         String // itunes_lookup | play_developer_api | manual
  contentHash    String
  fetchedAt      DateTime    @default(now()) @db.Timestamptz
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, platform, fetchedAt])
  @@map("application_store_listings")
}

model ApplicationAsset {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  applicationId  String      @db.Uuid
  kind           String // icon | screenshot | logo | video
  storageKey     String
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  createdAt      DateTime    @default(now()) @db.Timestamptz
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_assets")
}

model ApplicationCountry {
  organizationId String      @db.Uuid
  applicationId  String      @db.Uuid
  country        String      @db.Char(2)
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([applicationId, country])
  @@map("application_countries")
}

model ApplicationLanguage {
  organizationId String      @db.Uuid
  applicationId  String      @db.Uuid
  language       String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([applicationId, language])
  @@map("application_languages")
}

/// Monthly install goals (one row per app per month; overrides Application.monthlyInstallTarget).
model ApplicationTarget {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  applicationId  String      @db.Uuid
  month          DateTime    @db.Date // first day of month
  installs       Int
  targetCpiMinor BigInt?
  createdAt      DateTime    @default(now()) @db.Timestamptz
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, month])
  @@map("application_targets")
}

/// Custom conversion event definitions per app (registration, purchase, …).
model ApplicationEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  applicationId  String   @db.Uuid
  key            String // e.g. sign_up
  name           String
  category       String // registration | login | purchase | subscription | custom
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@unique([applicationId, key])
  @@map("application_events")
}

// ───────────────────────────── Integrations ─────────────────────────────

/// Platform-level provider catalogue, managed by Super Admin (enabled flag doubles as a feature flag).
model IntegrationProvider {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique // google_ads | apple_ads | meta_ads | tiktok_ads | firebase | ga4 | appsflyer | adjust | play_console | app_store_connect
  name          String
  category      String // advertising | analytics | store
  enabled       Boolean  @default(false)
  readiness     String   @default("not_configured") // not_configured | configured | verified
  readinessNote String   @default("")
  docsUrl       String   @default("")
  updatedAt     DateTime @updatedAt @db.Timestamptz

  @@map("integration_providers")
}

model ConnectedAccount {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @db.Uuid
  providerKey       String
  externalAccountId String
  name              String
  currency          String?                 @db.Char(3)
  timezone          String?
  status            IntegrationStatus       @default(PENDING)
  statusDetail      String                  @default("")
  scopes            String[]
  automationEnabled Boolean                 @default(true)
  connectedById     String?                 @db.Uuid
  lastSyncedAt      DateTime?               @db.Timestamptz
  tokenExpiresAt    DateTime?               @db.Timestamptz
  createdAt         DateTime                @default(now()) @db.Timestamptz
  updatedAt         DateTime                @updatedAt @db.Timestamptz
  deletedAt         DateTime?               @db.Timestamptz
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token             OAuthToken?
  permissions       IntegrationPermission[]
  appLinks          AccountApplication[]
  campaigns         Campaign[]

  @@unique([organizationId, providerKey, externalAccountId])
  @@index([status])
  @@map("connected_accounts")
}

/// Encrypted with AES-256-GCM (DATA_ENCRYPTION_KEY). Never returned by any API.
model OAuthToken {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  connectedAccountId String           @unique @db.Uuid
  accessTokenEnc     String
  refreshTokenEnc    String?
  tokenType          String           @default("Bearer")
  expiresAt          DateTime?        @db.Timestamptz
  refreshedAt        DateTime?        @db.Timestamptz
  createdAt          DateTime         @default(now()) @db.Timestamptz
  updatedAt          DateTime         @updatedAt @db.Timestamptz
  account            ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@map("oauth_tokens")
}

/// Short-lived OAuth state (PKCE verifier, org, return url). One-time use.
model OAuthState {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  userId          String    @db.Uuid
  providerKey     String
  stateHash       String    @unique
  codeVerifierEnc String?
  expiresAt       DateTime  @db.Timestamptz
  usedAt          DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz

  @@map("oauth_states")
}

model IntegrationPermission {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  connectedAccountId String           @db.Uuid
  capability         String // read_campaigns | manage_campaigns | read_reports | upload_creatives
  granted            Boolean
  checkedAt          DateTime         @default(now()) @db.Timestamptz
  detail             String           @default("")
  account            ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, capability])
  @@map("integration_permissions")
}

model AccountApplication {
  organizationId     String           @db.Uuid
  connectedAccountId String           @db.Uuid
  applicationId      String           @db.Uuid
  externalAppId      String? // the app's id inside the ad platform (Meta application id, TikTok app id)
  account            ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@id([connectedAccountId, applicationId])
  @@map("account_applications")
}

model IntegrationSyncLog {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  connectedAccountId String?  @db.Uuid
  providerKey        String
  operation          String
  status             String // ok | error | partial
  httpStatus         Int?
  errorCode          String?
  message            String   @default("")
  durationMs         Int?
  startedAt          DateTime @default(now()) @db.Timestamptz

  @@index([organizationId, startedAt])
  @@index([providerKey, status, startedAt])
  @@map("integration_sync_logs")
}

model WebhookEndpoint {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  providerKey    String
  secretEnc      String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@unique([organizationId, providerKey])
  @@map("webhook_endpoints")
}

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @db.Uuid
  providerKey    String
  externalId     String
  signatureValid Boolean
  payload        Json
  processedAt    DateTime? @db.Timestamptz
  error          String?
  receivedAt     DateTime  @default(now()) @db.Timestamptz

  @@unique([providerKey, externalId])
  @@map("webhook_events")
}

// ───────────────────────── Marketing intelligence ─────────────────────────

model MarketResearch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  applicationId  String   @db.Uuid
  executionId    String?  @db.Uuid
  summary        String
  markets        Json // [{country, opportunity, reasoning, confidence}]
  audiences      Json
  opportunities  Json
  evidence       Json // [{claim, source}]
  confidence     Decimal  @db.Decimal(3, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([applicationId, createdAt])
  @@map("market_research")
}

model Competitor {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  applicationId  String          @db.Uuid
  name           String
  website        String          @default("")
  notes          String          @default("")
  source         String          @default("ai") // ai | manual
  createdAt      DateTime        @default(now()) @db.Timestamptz
  apps           CompetitorApp[]

  @@unique([applicationId, name])
  @@map("competitors")
}

model CompetitorApp {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  competitorId   String     @db.Uuid
  platform       Platform
  storeId        String
  title          String     @default("")
  rating         Decimal?   @db.Decimal(3, 2)
  ratingCount    Int?
  lastFetchedAt  DateTime?  @db.Timestamptz
  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, platform, storeId])
  @@map("competitor_apps")
}

model KeywordResearch {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @db.Uuid
  applicationId       String    @db.Uuid
  platform            Platform?
  country             String    @default("IN")
  keyword             String
  relevance           Decimal   @db.Decimal(3, 2)
  estimatedPopularity String    @default("unknown") // low | medium | high | unknown (no vendor data)
  competition         String    @default("unknown")
  source              String    @default("ai")
  createdAt           DateTime  @default(now()) @db.Timestamptz

  @@unique([applicationId, country, keyword])
  @@map("keyword_research")
}

model AsoAudit {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  applicationId     String   @db.Uuid
  platform          Platform
  listingId         String?  @db.Uuid
  executionId       String?  @db.Uuid
  score             Int
  findings          Json // [{area, issue, recommendation, impact}]
  suggestedTitle    String   @default("")
  suggestedSubtitle String   @default("")
  suggestedKeywords Json     @default("[]")
  localization      Json     @default("[]")
  createdAt         DateTime @default(now()) @db.Timestamptz

  @@index([applicationId, createdAt])
  @@map("aso_audits")
}

model AudienceSegment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  applicationId  String   @db.Uuid
  name           String
  description    String
  countries      String[]
  ageRange       String   @default("")
  interests      String[]
  source         String   @default("ai")
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@map("audience_segments")
}

model MarketingStrategy {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @db.Uuid
  applicationId        String         @db.Uuid
  executionId          String?        @db.Uuid
  month                DateTime?      @db.Date
  title                String
  summary              String
  channels             Json // [{provider, share, rationale}]
  countryAllocations   Json
  estimatedCpiMinor    BigInt?
  estimatedBudgetMinor BigInt?
