  id                String                        @id @default(uuid()) @db.Uuid
  organizationId    String                        @db.Uuid
  month             DateTime                      @db.Date
  monthlyLimitMinor BigInt
  dailyLimitMinor   BigInt?
  currency          String                        @db.Char(3)
