  aggregateAttributedInstalls Int      @default(0) // SKAN/AAK — not de-duplicable against user-level
  registrations               Int      @default(0)
  activeUsers                 Int      @default(0)
  spendMinor                  BigInt   @default(0)
  currency                    String   @db.Char(3)
  computedAt                  DateTime @default(now()) @db.Timestamptz

  @@unique([applicationId, platform, date])
  @@index([organizationId, date])
  @@map("analytics_daily")
}

model AnalyticsCampaignDaily {
