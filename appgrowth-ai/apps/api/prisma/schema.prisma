  spendMinor     BigInt   @default(0)
  currency       String   @db.Char(3)
  syncedAt       DateTime @default(now()) @db.Timestamptz
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date, country])
  @@index([organizationId, date])
  @@map("campaign_metrics")
}

/// Every action on a campaign (user or agent). Idempotency key makes retried executions safe.
model CampaignAction {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  campaignId     String    @db.Uuid
  action         String // create | launch | pause | resume | budget_change | sync | archive
  actor          String // user:<id> | agent:<key> | system
  idempotencyKey String    @unique
  status         String    @default("pending") // pending | succeeded | failed
  request        Json      @default("{}")
  response       Json      @default("{}")
  error          String?
  createdAt      DateTime  @default(now()) @db.Timestamptz
  completedAt    DateTime? @db.Timestamptz
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@map("campaign_actions")
}

model CampaignExperiment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  campaignId     String    @db.Uuid
