  @@index([campaignId, effectiveFrom])
  @@map("campaign_budgets")
}

/// Daily metrics as reported by the ad platform. Upserted per (campaign, date) so re-syncs replace, never add.
model CampaignMetric {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  campaignId     String   @db.Uuid
  date           DateTime @db.Date
  country        String   @default("ZZ") @db.Char(2) // ZZ = all/unknown
