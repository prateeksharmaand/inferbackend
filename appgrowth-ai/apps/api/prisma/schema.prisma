  @@map("organization_budgets")
}

model AdvertisingBudgetAllocation {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  budgetId       String             @db.Uuid
  applicationId  String?            @db.Uuid
  provider       AdProvider?
  platform       Platform?
  country        String?            @db.Char(2)
  limitMinor     BigInt
  createdAt      DateTime           @default(now()) @db.Timestamptz
  budget         OrganizationBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@map("advertising_budget_allocations")
}

/// Spend as reported by each ad account, per day. Source of truth for budget enforcement.
model AdvertisingSpend {
  id                 String     @id @default(uuid()) @db.Uuid
  organizationId     String     @db.Uuid
  connectedAccountId String     @db.Uuid
  campaignId         String?    @db.Uuid
  provider           AdProvider
  date               DateTime   @db.Date
  amountMinor        BigInt
  currency           String     @db.Char(3)
  syncedAt           DateTime   @default(now()) @db.Timestamptz

  @@unique([connectedAccountId, campaignId, date])
  @@index([organizationId, date])
  @@map("advertising_spend")
}

model SubscriptionTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  subscriptionId String   @db.Uuid
  kind           String // created | renewed | upgraded | downgraded | cancelled | trial_converted
  fromPlanKey    String?
  toPlanKey      String?
  actor          String
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([organizationId])
  @@map("subscription_transactions")
}

model UsageCharge {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  month          DateTime @db.Date
  metric         String // ai_tokens | ai_generations | storage_bytes
  quantity       BigInt
  amountMinor    BigInt   @default(0)
  currency       String   @db.Char(3)
  invoiceId      String?  @db.Uuid

  @@unique([organizationId, month, metric])
  @@map("usage_charges")
}

/// Platform's own costs (AI providers, infra) attributed to orgs for margin reporting.
model CostRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  category       String // ai | storage | email | infra
  description    String
  amountMicros   BigInt // USD micros
  date           DateTime @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([date])
  @@map("cost_records")
}

// ───────────────────────── Platform operations ─────────────────────────

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String?             @db.Uuid
  userId         String              @db.Uuid
  kind           String // budget_threshold | campaign_failed | integration_expiring | unusual_spend | target_risk | report_ready | ...
  severity       String              @default("info") // info | warning | critical
  title          String
  body           String
  link           String?
  channel        NotificationChannel @default(IN_APP)
  dedupeKey      String?
  readAt         DateTime?           @db.Timestamptz
  emailedAt      DateTime?           @db.Timestamptz
  createdAt      DateTime            @default(now()) @db.Timestamptz

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  kind           String
  inApp          Boolean  @default(true)
  email          Boolean  @default(true)
  config         Json     @default("{}") // thresholds, e.g. {"cpiMultiple": 1.5}
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@unique([organizationId, userId, kind])
  @@map("notification_preferences")
}

model Report {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  kind           String // daily | weekly | monthly | budget | campaign | installs | recommendations
  title          String
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  applicationId  String?   @db.Uuid
  status         String    @default("queued") // queued | ready | failed
  data           Json?
  pdfKey         String?
  csvKey         String?
  error          String?
  requestedById  String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz
  readyAt        DateTime? @db.Timestamptz

  @@index([organizationId, createdAt])
  @@map("reports")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  actor          String // user:<id> | agent:<key> | system
  action         String
  entityType     String?
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  security       Boolean  @default(false) // login failures, MFA changes, token reuse...
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([organizationId, createdAt])
  @@index([security, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SupportTicket {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  openedById     String       @db.Uuid
  subject        String
  status         TicketStatus @default(OPEN)
  priority       String       @default("normal")
  assignedToId   String?      @db.Uuid
  messages       Json         @default("[]") // [{authorId, body, at, staff}]
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  @@index([status, updatedAt])
  @@index([organizationId])
  @@map("support_tickets")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("system_settings")
}

model FeatureFlag {
  key          String   @id
  description  String   @default("")
  enabled      Boolean  @default(false)
  orgAllowList String[] // org ids that get the flag even when globally disabled
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@map("feature_flags")
}

model ApiLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  userId         String?  @db.Uuid
  method         String
  route          String
  status         Int
  durationMs     Int
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@map("api_logs")
}

model ErrorLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  service        String // api | worker | scheduler | ai
  message        String
  stack          String?
  context        Json?
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
  @@map("error_logs")
}
