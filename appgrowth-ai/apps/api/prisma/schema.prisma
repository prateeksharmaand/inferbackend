  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  applicationId      String          @db.Uuid
  platform           Platform
  source             String // firebase | appsflyer | adjust | ga4 | sdk
  dedupeKey          String
  deviceIdHash       String? // salted SHA-256, never raw advertising IDs
  kind               InstallKind
  attribution        AttributionType
  campaignId         String?         @db.Uuid
  externalCampaignId String?
  mediaSource        String?
