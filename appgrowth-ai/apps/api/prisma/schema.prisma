  category       String // registration | login | purchase | subscription | engagement | custom
  platform       Platform?
  source         String
  dedupeKey      String
  deviceIdHash   String?
  campaignId     String?  @db.Uuid
  country        String   @default("ZZ") @db.Char(2)
  valueMinor     BigInt?
  currency       String?  @db.Char(3)
  occurredAt     DateTime @db.Timestamptz
  receivedAt     DateTime @default(now()) @db.Timestamptz

  @@unique([applicationId, dedupeKey])
  @@index([applicationId, eventKey, occurredAt])
  @@map("conversion_events")
}

/// Rollups rebuilt by the analytics engine (idempotent: delete+insert per app/date range in one transaction).
model AnalyticsDaily {
  id                          String   @id @default(uuid()) @db.Uuid
  organizationId              String   @db.Uuid
  applicationId               String   @db.Uuid
