# ---------------------------------------------------------------------------
# CareerPilot AI configuration. Copy to .env and fill in. NEVER commit .env.
# Timestamps are stored in UTC; APP_TIMEZONE is used for display & schedules.
# Salaries everywhere are INR lakhs per annum (LPA).
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=CareerPilot AI
APP_TIMEZONE=Asia/Kolkata
APP_BASE_URL=http://localhost:3000          # public URL, used in notification links
DOMAIN=localhost                             # docker/nginx: your domain, e.g. careers.example.com

# Database / cache. In docker-compose these are set automatically from POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://user@localhost/careerpilot
POSTGRES_PASSWORD=change-me-long-random
REDIS_URL=redis://localhost:6379/0

# AI provider: anthropic | gemini | auto (auto = Claude if its key is set, else Gemini)
AI_PROVIDER=auto
# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Claude API (https://console.anthropic.com). Model is configurable; default claude-opus-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=medium                              # low | medium | high | xhigh | max

# Security. Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Generate:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ALLOW_REGISTRATION=true                       # set false after creating your account
COOKIE_SECURE=                                # blank = true in production (needs HTTPS)
CORS_ORIGINS=["http://localhost:3000"]

# Telegram: create a bot with @BotFather, send it a message, then read chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP). For Gmail: smtp.gmail.com, port 587, your address, and a Google App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=                              # where notifications go (defaults to your login email)

# Gmail API (optional; SMTP above already covers sending)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Job search providers
JOB_SEARCH_API_KEY=                           # Adzuna "app_id:app_key" (developer.adzuna.com)
SEARCH_PROVIDER_API_KEY=                      # JSearch on RapidAPI (LinkedIn/Indeed/Naukri/Foundit via Google for Jobs)

STORAGE_PATH=/app/storage
MAX_UPLOAD_MB=10
