# Rendered by the nginx image's envsubst at start-up (${DOMAIN}).
# HTTP: ACME challenge + redirect to HTTPS (if a certificate exists) — see docs/DEPLOYMENT.md
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;

upstream cp_backend  { server backend:8000; }
upstream cp_frontend { server frontend:3000; }

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  listen 80;
  server_name ${DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  include /etc/nginx/conf.d/https-redirect.inc*;
  include /etc/nginx/conf.d/app-locations.inc;
}

include /etc/nginx/conf.d/https-server.inc*;
